  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Budowa wie\u017C to jedyny spos\xF3b na przetrwanie. Ka\u017Cda jednostka
    obronna ma inn\u0105 specyfikacj\u0119.\n\nZr\xF3\u017Cnicowany Ogie\u0144: Niekt\xF3re
    wie\u017Ce strzelaj\u0105 szybko, zasypuj\u0105c wroga gradem pocisk\xF3w, inne
    potrzebuj\u0105 czasu na prze\u0142adowanie, ale ich uderzenie jest druzgoc\u0105ce.\n\nTypy
    Obra\u017Ce\u0144: Dobieraj bro\u0144 m\u0105drze. Cz\u0119\u015B\u0107 wie\u017C
    zadaje czyste obra\u017Cenia, podczas gdy inne s\u0142u\u017C\u0105 do nak\u0142adania
    efekt\xF3w (np. spowolnienia), u\u0142atwiaj\u0105c eliminacj\u0119 cel\xF3w
    pozosta\u0142ym dzia\u0142om.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
